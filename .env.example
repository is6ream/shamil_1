# Шаблон окружения. Скопируйте в .env и заполните:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (.gitignore) — секреты только через окружение.

# ─── Общее ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Эти три переменные читает docker compose при создании тома базы.
POSTGRES_USER=shamil
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=shamil
POSTGRES_PORT=5432

# ─── Бэкенд (apps/api) ───────────────────────────────────────────────────────
API_PORT=3001
DATABASE_URL=postgresql://shamil:change_me_locally@localhost:5432/shamil
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ─── Фронтенд (apps/web) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_* попадают в клиентский бандл — только публичные значения.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Платёжный провайдер ─────────────────────────────────────────────────────
# Заполняется, когда заказчик подтвердит агрегатора (блокер из CONTEXT.md §8).
# Секрет подписи вебхука — обязательный: неподписанный колбэк должен получать 401.
PAYMENT_PROVIDER=manual
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
