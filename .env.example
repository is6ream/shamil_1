# Шаблон окружения. Скопируйте в .env и заполните:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (.gitignore) — секреты только через окружение.

# ─── Общее ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Эти три переменные читает docker compose при создании тома базы.
# POSTGRES_PORT — порт на хосте. 5432 часто занят локально установленным
# PostgreSQL, поэтому порт вынесен в переменную: подставьте любой свободный
# и не забудьте тот же номер в DATABASE_URL.
POSTGRES_USER=shamil
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=shamil
POSTGRES_PORT=5432

# ─── Бэкенд (apps/api) ───────────────────────────────────────────────────────
API_PORT=3001
DATABASE_URL=postgresql://shamil:change_me_locally@localhost:5432/shamil
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ─── Тестовая база ───────────────────────────────────────────────────────────
# Отдельная база для тестов схемы: они очищают таблицы целиком, направлять их
# на рабочую базу нельзя. Создавать руками не нужно — прогон тестов создаёт её
# сам и накатывает миграции.
# Если переменная не задана или сервер недоступен, тесты на БД (переходы статуса,
# идемпотентность вебхука, витринные счётчики) пропускаются с предупреждением.
TEST_DATABASE_URL=postgresql://shamil:change_me_locally@localhost:5432/shamil_test

# ─── Фронтенд (apps/web) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_* попадают в клиентский бандл — только публичные значения.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Публичные адреса ────────────────────────────────────────────────────────
# Внешние адреса, которых приложение за Nginx о себе не знает. Из PUBLIC_API_URL
# собирается Result URL, который заказчик вбивает в кабинет Robokassa.
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# ─── Платёжный провайдер ─────────────────────────────────────────────────────
# manual — ручной перевод по реквизитам; работает всегда и не требует секретов.
# robokassa — агрегатор РФ: СБП, SberPay, T-Pay и карты одним мерчант-аккаунтом.
PAYMENT_PROVIDER=manual

# Дальше — только для PAYMENT_PROVIDER=robokassa. Приложение не поднимется,
# если агрегатор выбран, а активная пара паролей пуста.
#
# PAYMENT_IS_TEST значения по умолчанию не имеет намеренно: выбор между боевыми
# и тестовыми деньгами не должен достаться молча. Боевой сбор, ушедший в тестовый
# режим, выглядит как работающий сайт — «спасибо» показано, на счету пусто.
PAYMENT_IS_TEST=true
PAYMENT_MERCHANT_ID=

# Боевая пара из кабинета (нужна при PAYMENT_IS_TEST=false).
# Пароль #1 подписывает исходящую ссылку, Пароль #2 — проверяет колбэк.
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Тестовая пара (нужна при PAYMENT_IS_TEST=true). Кабинет выдаёт её отдельно:
# на ней интеграция пишется и гоняется, пока мерчант проходит модерацию.
PAYMENT_TEST_SECRET_KEY=
PAYMENT_TEST_WEBHOOK_SECRET=

# Алгоритм подписи из кабинета мерчанта: md5 (значение по умолчанию) или sha256.
# Строка подписи от него не зависит — меняется только хеш-функция.
PAYMENT_HASH_ALGORITHM=md5

# Фискализация (54-ФЗ, Робочеки). Пока выключена — заказчик не подтвердил
# подключение (docs/payments-setup.md, шаг 5). При true обязательны все три
# поля ниже, и Receipt начинает участвовать в строке подписи.
#   PAYMENT_RECEIPT_SNO: osn | usn_income | usn_income_outcome | esn | patent
#   PAYMENT_RECEIPT_VAT: none | vat0 | vat10 | vat110 | vat20 | vat120
PAYMENT_RECEIPT_ENABLED=false
PAYMENT_RECEIPT_SNO=
PAYMENT_RECEIPT_ITEM_NAME=
PAYMENT_RECEIPT_VAT=

# ─── Админские эндпоинты ─────────────────────────────────────────────────────
# Статический токен: полноценной аутентификации в MVP нет, админка — это
# защищённые эндпоинты, а не UI. Им закрыто подтверждение ручного перевода
# (POST /api/admin/donations/:id/confirm) — операция, двигающая сумму сбора.
#
# Обязателен при NODE_ENV=production, минимум 32 символа; локально можно
# не задавать — тогда админские эндпоинты отвечают 401 на любой запрос.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Вызов:
#   curl -X POST http://localhost:3001/api/admin/donations/<uuid>/confirm \
#     -H "Authorization: Bearer $ADMIN_API_TOKEN"
ADMIN_API_TOKEN=e1123aca85e6b1147ab8515d66f69948aa58b9ab5176ac7d9da4ce8691426d5a
