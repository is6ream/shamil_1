# Шаблон окружения. Скопируйте в .env и заполните:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (.gitignore) — секреты только через окружение.

# ─── Общее ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# Стадия: local | demo | production. Только demo (демо-стенд на Vercel,
# docs/deploy-vercel-demo.md) разрешает эмулятор оплаты при NODE_ENV=production.
DEPLOY_STAGE=local

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Эти три переменные читает docker compose при создании тома базы.
# POSTGRES_PORT — порт на хосте. 5432 часто занят локально установленным
# PostgreSQL, поэтому порт вынесен в переменную: подставьте любой свободный
# и не забудьте тот же номер в DATABASE_URL.
POSTGRES_USER=shamil
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=shamil
POSTGRES_PORT=5432

# ─── Бэкенд (apps/api) ───────────────────────────────────────────────────────
API_PORT=3001
# PORT назначает хостинг (Vercel, PaaS); если задан, приоритетнее API_PORT.
# Локально не задаётся.
DATABASE_URL=postgresql://shamil:change_me_locally@localhost:5432/shamil
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ─── Тестовая база ───────────────────────────────────────────────────────────
# Отдельная база для тестов схемы: они очищают таблицы целиком, направлять их
# на рабочую базу нельзя. Создавать руками не нужно — прогон тестов создаёт её
# сам и накатывает миграции.
# Если переменная не задана или сервер недоступен, тесты на БД (переходы статуса,
# идемпотентность вебхука, витринные счётчики) пропускаются с предупреждением.
TEST_DATABASE_URL=postgresql://shamil:change_me_locally@localhost:5432/shamil_test

# ─── Фронтенд (apps/web) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_* попадают в клиентский бандл — только публичные значения.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Публичные адреса ────────────────────────────────────────────────────────
# Внешние адреса, которых приложение за Nginx о себе не знает. Из PUBLIC_API_URL
# собирается Result URL, который заказчик вбивает в кабинет Robokassa.
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# ─── Платёжный провайдер ─────────────────────────────────────────────────────
# Онлайн-агрегатор приложения. Перевод по реквизитам (таб «Расчётный счёт»)
# работает всегда, независимо от этой переменной.
# manual — онлайн выключен: таб «Онлайн» получает 400 «переведите по реквизитам».
# robokassa — агрегатор РФ: СБП, SberPay, T-Pay и карты одним мерчант-аккаунтом.
PAYMENT_PROVIDER=manual

# Дальше — только для PAYMENT_PROVIDER=robokassa. Приложение не поднимется,
# если агрегатор выбран, а активная пара паролей пуста.
#
# PAYMENT_IS_TEST значения по умолчанию не имеет намеренно: выбор между боевыми
# и тестовыми деньгами не должен достаться молча. Боевой сбор, ушедший в тестовый
# режим, выглядит как работающий сайт — «спасибо» показано, на счету пусто.
PAYMENT_IS_TEST=true
PAYMENT_MERCHANT_ID=

# Боевая пара из кабинета (нужна при PAYMENT_IS_TEST=false).
# Пароль #1 подписывает исходящую ссылку, Пароль #2 — проверяет колбэк.
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Тестовая пара (нужна при PAYMENT_IS_TEST=true). Кабинет выдаёт её отдельно:
# на ней интеграция пишется и гоняется, пока мерчант проходит модерацию.
PAYMENT_TEST_SECRET_KEY=
PAYMENT_TEST_WEBHOOK_SECRET=

# Алгоритм подписи из кабинета мерчанта: md5 (значение по умолчанию) или sha256.
# Строка подписи от него не зависит — меняется только хеш-функция.
PAYMENT_HASH_ALGORITHM=md5

# Адрес страницы оплаты. По умолчанию — боевая Robokassa; меняется только ради
# локального эмулятора. В production допустим только https://auth.robokassa.ru/…
# PAYMENT_ROBOKASSA_URL=https://auth.robokassa.ru/Merchant/Index.aspx

# Локальный эмулятор страницы оплаты Robokassa — сквозная оплата без мерчанта
# (README, «Локальный запуск с тестовой оплатой»). Деньги не списываются.
# Требует PAYMENT_PROVIDER=robokassa и PAYMENT_IS_TEST=true; в production
# приложение с ним не стартует.
PAYMENT_EMULATOR_ENABLED=false

# HMAC-ключ ссылок сценариев эмулятора, минимум 32 символа. Не задан — ключ
# случайный на каждый запуск процесса: локально это нормально, но на serverless
# (несколько инстансов, холодный старт) ссылка «Оплатить» перестаёт открываться.
# PAYMENT_EMULATOR_LINK_SECRET=

# Фискализация (54-ФЗ, Робочеки). Пока выключена — заказчик не подтвердил
# подключение (docs/payments-setup.md, шаг 5). При true обязательны все три
# поля ниже, и Receipt начинает участвовать в строке подписи.
#   PAYMENT_RECEIPT_SNO: osn | usn_income | usn_income_outcome | esn | patent
#   PAYMENT_RECEIPT_VAT: none | vat0 | vat10 | vat110 | vat20 | vat120
PAYMENT_RECEIPT_ENABLED=false
PAYMENT_RECEIPT_SNO=
PAYMENT_RECEIPT_ITEM_NAME=
PAYMENT_RECEIPT_VAT=

# ─── Админские эндпоинты ─────────────────────────────────────────────────────
# Статический токен для скриптов (D-07). Админка работает по сессиям (ниже),
# а токен по-прежнему принимает только подтверждение ручного перевода
# (POST /api/admin/donations/:id/confirm) — операция, двигающая сумму сбора.
#
# Обязателен при NODE_ENV=production, минимум 32 символа; локально можно
# не задавать — тогда админские эндпоинты отвечают 401 на любой запрос.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Вызов:
#   curl -X POST http://localhost:3001/api/admin/donations/<uuid>/confirm \
#     -H "Authorization: Bearer $ADMIN_API_TOKEN"
ADMIN_API_TOKEN=

# ─── Админ-панель: сессии ────────────────────────────────────────────────────
# Ключ подписи access-JWT (15 минут). Обязателен в production, минимум 32 символа.
# Локально можно не задавать — ключ будет случайным на каждый запуск, и сессии
# не переживут перезапуск бэкенда.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=
# Флаг Secure у refresh-cookie. По умолчанию true при NODE_ENV=production.
# ADMIN_COOKIE_SECURE=

# Первый суперадмин — создаётся сидом (npm run db:seed / node dist/database/seed/index.js),
# только если пользователя с таким e-mail ещё нет. Повторный запуск пароль не меняет.
# Пароль — не короче 12 символов и не длиннее 72 байт. После первого входа смените его
# в админке и удалите переменную из окружения.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ─── Медиатека ───────────────────────────────────────────────────────────────
# local — файлы на диске (только dev/test); s3 — бакет. В production — только s3:
# диск контейнера Timeweb App Platform эфемерен, приложение с local не стартует.
STORAGE_DRIVER=local
# Каталог для local (относительно рабочего каталога процесса) и адрес раздачи.
# По умолчанию файлы отдаёт сам Nest: ${PUBLIC_API_URL}/media/...
MEDIA_LOCAL_DIR=uploads
# MEDIA_PUBLIC_URL=http://localhost:3001/media
# Лимит размера загружаемой фотографии, МБ (1…50).
MEDIA_MAX_UPLOAD_MB=15

# S3 (Timeweb Cloud Object Storage). Нужны все при STORAGE_DRIVER=s3.
# S3_BUCKET=
# S3_REGION=ru-1
# S3_ENDPOINT=https://s3.timeweb.cloud
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Публичный адрес бакета — от него строятся ссылки на картинки на сайте:
# S3_PUBLIC_BASE_URL=https://s3.timeweb.cloud/<bucket>
# path-style адресация (endpoint/bucket/key); false — bucket.endpoint/key.
# S3_FORCE_PATH_STYLE=true

# ─── Ревалидация фронтенда ───────────────────────────────────────────────────
# Общий секрет с Next.js (та же переменная во фронтенде), минимум 32 символа.
# Не задан — ревалидация выключена: правки из админки появятся на сайте по
# истечении кеша (до часа).
REVALIDATE_SECRET=
# Куда API шлёт POST {"tags":[...]}. По умолчанию ${PUBLIC_SITE_URL}/api/revalidate.
# WEB_REVALIDATE_URL=
