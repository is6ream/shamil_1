// Схема БД сбора на мечеть «Шамиль». День 5 роудмапа.
//
// Правила, которые задают вид этой схемы (CONTEXT.md §7, CLAUDE.md «Платежи»):
//   • Все деньги — BigInt в копейках. Ни одного числа с плавающей точкой.
//   • Донат живёт как pending → paid, paid финально; обратный переход запрещён
//     триггером в БД, а не только кодом (см. migrations/…_guards_and_stats).
//   • Идемпотентность вебхука — уникальный (provider, provider_event_id)
//     в payment_event: агрегаторы ретраят колбэк до 200.
//   • donation.region_id — nullable: платёж важнее статистики.
//   • Витринные счётчики — отдельные таблицы campaign_stats / region_stats,
//     а не SUM() по донатам.
//   • Телефон — только в donation_contact, в публичные выборки не попадает (152-ФЗ).
//
// Всё, что Prisma выразить не умеет (CHECK, триггеры, EXCLUDE), лежит во второй
// миграции обычным SQL. При генерации новых миграций их нельзя терять —
// целостность сумм держится на них. Тест `schema-guards.spec.ts` это проверяет.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

// Строка подключения — в prisma.config.ts: в Prisma 7 `url` в схеме не поддерживается.
datasource db {
  provider = "postgresql"
}

/// Уровень справочника регионов: страна (Казахстан) или субъект РФ (Башкортостан).
enum RegionType {
  country
  subject

  @@map("region_type")
}

/// Состояния доната. pending → paid (финально) или pending → failed.
/// failed → paid разрешён: деньги могли дойти после отказного колбэка,
/// и терять их нельзя. Обратно в pending не возвращается никогда.
enum DonationStatus {
  pending
  paid
  failed

  @@map("donation_status")
}

/// Сбор. В MVP он один, но таблица — не singleton: заказчик может запустить
/// второй сбор (например, на внутреннюю отделку), и переписывать схему не хочется.
model Campaign {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String @unique @db.VarChar(64)
  title    String @db.VarChar(200)
  /// Общая цель сбора в копейках: 240 000 000 ₽ = 24 000 000 000 копеек.
  /// Цель на месяц живёт отдельной сущностью — см. CampaignMonthlyGoal.
  goalKopecks BigInt @map("goal_kopecks")
  /// Валюта учёта. Все суммы сбора сводятся к ней; платёж в тенге или сомах
  /// приходит в charged_currency доната.
  currency           String   @default("RUB") @db.Char(3)
  minDonationKopecks BigInt   @default(10000) @map("min_donation_kopecks")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  stats        CampaignStats?
  monthlyGoals CampaignMonthlyGoal[]
  donations    Donation[]
  galleryItems GalleryItem[]

  @@map("campaign")
}

/// Витринные счётчики сбора. Отдельно от campaign: строка обновляется на каждом
/// оплаченном донате, а конфиг сбора при этом не блокируется.
/// Пересчёт — триггером donation_stats_sync, чтобы ручной донат из админки
/// и сид считались так же, как вебхук.
model CampaignStats {
  campaignId       String    @id @map("campaign_id") @db.Uuid
  paidTotalKopecks BigInt    @default(0) @map("paid_total_kopecks")
  paidCount        Int       @default(0) @map("paid_count")
  lastPaidAt       DateTime? @map("last_paid_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_stats")
}

/// Цель на месяц — отдельная сущность, а не колонка в campaign: без границ периода
/// цифра ничего не значит, а историю месяцев затирать нельзя. Из неё собирается
/// верхняя шкала двойного прогресс-бара (блок 2 ТЗ), та, что реально заполняется.
/// Периоды одного сбора не пересекаются — EXCLUDE-ограничение в миграции.
model CampaignMonthlyGoal {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  periodStart      DateTime @map("period_start") @db.Date
  periodEnd        DateTime @map("period_end") @db.Date
  goalKopecks      BigInt   @map("goal_kopecks")
  collectedKopecks BigInt   @default(0) @map("collected_kopecks")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, periodStart])
  @@index([campaignId, periodStart, periodEnd])
  @@map("campaign_monthly_goal")
}

/// Справочник «откуда вы»: страны и субъекты РФ в одном списке — заказчик
/// подтвердил, что в таблице показываем и регионы, и страны. Без стран
/// донаты через Kaspi (KZ) и Mbank (KG) некуда класть.
/// Регион никогда не определяется по IP (VPN и роуминг врут) — только выбор
/// в форме или региональная ссылка /{slug}/.
model Region {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        RegionType
  /// Субъект ссылается на свою страну; у страны parent_id пуст.
  parentId    String?    @map("parent_id") @db.Uuid
  countryCode String     @map("country_code") @db.Char(2)
  /// Официальный код субъекта: '02' — Башкортостан, '95' — Чечня. У стран пуст.
  code        String?    @db.VarChar(8)
  /// Сегмент короткой ссылки: /02/, /kz/. Его диктуют голосом — держим коротким.
  slug        String     @unique @db.VarChar(32)
  name        String     @db.VarChar(120)
  flagUrl     String?    @map("flag_url") @db.VarChar(500)
  sortOrder   Int        @default(100) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  /// Участвует ли строка в рейтинге. «Россия» выбирается в форме, но в таблице
  /// землячеств не соревнуется с субъектами — иначе она всегда первая.
  isRanked    Boolean    @default(true) @map("is_ranked")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent    Region?      @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Region[]     @relation("RegionHierarchy")
  stats     RegionStats?
  donations Donation[]

  @@unique([countryCode, code])
  @@index([type, sortOrder, name])
  @@index([parentId])
  @@map("region")
}

/// Счётчики региона для блока 4 ТЗ. Строка создаётся триггером на каждый регион
/// сразу, с нулями: «ещё N регионов ждут первого пожертвования» — это запрос
/// к этой таблице, а не вычисление разницы с донатами.
model RegionStats {
  regionId         String    @id @map("region_id") @db.Uuid
  paidTotalKopecks BigInt    @default(0) @map("paid_total_kopecks")
  paidCount        Int       @default(0) @map("paid_count")
  lastPaidAt       DateTime? @map("last_paid_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([paidTotalKopecks(sort: Desc)])
  @@map("region_stats")
}

/// Донат. Идентификатор доната — он же order_id на странице «спасибо»:
/// uuid не перебрать, отдельный публичный номер не нужен.
model Donation {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Числовой номер счёта для провайдера: Robokassa принимает InvId только
  /// целым числом (0…2147483647), uuid ей отдать нельзя. Значение выдаёт
  /// последовательность в БД — счётчик в сервисе дал бы гонку на двух инстансах.
  /// Публичный идентификатор заказа при этом остаётся uuid'ом: его не перебрать.
  /// SERIAL, а не dbgenerated: иначе Prisma видит дрейф и следующая
  /// `migrate dev` сама сгенерирует «исправление» боевой таблицы.
  invoiceNo  Int            @unique @default(autoincrement()) @map("invoice_no")
  campaignId String         @map("campaign_id") @db.Uuid
  /// Nullable намеренно: донат без региона обязан проходить (CLAUDE.md).
  regionId   String?        @map("region_id") @db.Uuid
  status     DonationStatus @default(pending)
  /// Сумма заказа, которую сформировал сервер. Клиентскому значению не верим:
  /// оно проходит только через валидацию DTO и пересчёт на бэкенде.
  amountKopecks BigInt @map("amount_kopecks")
  /// Фактически оплаченная сумма — из вебхука. Заполнена у всех paid-донатов
  /// (CHECK в миграции) и только она попадает в витринные счётчики.
  paidAmountKopecks BigInt? @map("paid_amount_kopecks")
  /// Валюта реального списания: RUB для агрегатора РФ, KZT для Kaspi,
  /// KGS для Mbank. Учётная сумма при этом всегда в копейках рубля.
  chargedCurrency    String  @default("RUB") @map("charged_currency") @db.Char(3)
  chargedAmountMinor BigInt? @map("charged_amount_minor")
  /// Код провайдера: 'manual' | 'robokassa' | 'kaspi' | 'mbank'. Не enum —
  /// агрегатор ещё не согласован (блокер), а миграцию enum'а на проде не хочется.
  provider          String  @default("manual") @db.VarChar(32)
  /// Способ внутри провайдера: 'sbp' | 'card' | 'sberpay' | 'tpay' | 'bank_transfer'.
  /// Показывается в живой ленте поступлений.
  method            String? @db.VarChar(32)
  /// Идентификатор платежа на стороне провайдера (счёт, инвойс).
  providerPaymentId String? @map("provider_payment_id") @db.VarChar(128)
  /// Публичная подпись для ленты и топа донатеров. У анонимного доната пуста —
  /// это CHECK в миграции: чего в таблице нет, то невозможно показать по ошибке.
  /// Имя для сверки платежей живёт в donation_contact.full_name.
  donorName         String? @map("donor_name") @db.VarChar(120)
  /// Анонимность включена по умолчанию: садака — скрытое поклонение (блок 9 ТЗ).
  /// В топ донатеров попадают только те, кто снял галочку сознательно.
  isAnonymous  Boolean @default(true) @map("is_anonymous")
  /// Откуда взялся регион: 'link' (региональная ссылка), 'form' (селектор),
  /// 'admin'. У референса атрибуция была ~7%, и понять это можно было только так.
  regionSource String? @map("region_source") @db.VarChar(16)

  /// Атрибуция first-touch: метки первого захода на сайт (cookie на 30 дней).
  /// Все поля необязательны — донат без меток обязан проходить, как и без региона.
  utmSource   String? @map("utm_source") @db.VarChar(128)
  utmMedium   String? @map("utm_medium") @db.VarChar(128)
  utmCampaign String? @map("utm_campaign") @db.VarChar(128)
  utmContent  String? @map("utm_content") @db.VarChar(128)
  utmTerm     String? @map("utm_term") @db.VarChar(128)
  /// Внешний Referer первого захода. Свой домен сюда не пишется.
  referrer    String? @db.VarChar(512)
  /// Путь страницы первого захода: `/02/`, `/?utm_source=…` без домена.
  landingPage String? @map("landing_page") @db.VarChar(512)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(3)

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  region   Region?          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  contact  DonationContact?
  events   PaymentEvent[]

  @@unique([provider, providerPaymentId])
  /// Индекс живой ленты: keyset-пагинация по (paid_at, id), без OFFSET.
  @@index([status, paidAt(sort: Desc), id(sort: Desc)])
  @@index([campaignId, status])
  @@index([regionId, status])
  /// Топ донатеров: только status=paid и is_anonymous=false.
  @@index([status, isAnonymous, paidAmountKopecks(sort: Desc)])
  /// UTM-отчёт админки: разбивка оплаченных донатов по источнику и кампании.
  @@index([status, utmSource, utmCampaign])
  @@map("donation")
}

/// Персональные данные донатера — отдельной таблицей (152-ФЗ):
///   • публичные выборки (лента, топы, рейтинг) читают только donation
///     и физически не могут вытащить телефон;
///   • по требованию об удалении ПДн строка удаляется, донат и сумма сбора
///     остаются на месте.
model DonationContact {
  donationId String  @id @map("donation_id") @db.Uuid
  /// Телефон строго в E.164: +79991234567. Формат проверяет CHECK в миграции.
  phoneE164  String? @map("phone_e164") @db.VarChar(16)
  /// Имя как его ввёл донатер — нужно для сверки поступлений по реквизитам.
  /// Публичная подпись — это donation.donor_name, а не это поле.
  fullName   String? @map("full_name") @db.VarChar(120)
  /// Отметка согласия на обработку ПДн — обязательна: без неё строки быть не должно.
  personalDataConsentAt DateTime @map("personal_data_consent_at") @db.Timestamptz(3)
  consentIp             String?  @map("consent_ip") @db.Inet
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@map("donation_contact")
}

/// Колбэки провайдера. Уникальный (provider, provider_event_id) — это и есть
/// идемпотентность: повтор доставки упирается в индекс, донат не задваивается
/// ни в сумме сбора, ни в рейтинге региона.
/// Сырое тело храним для разбора спорных платежей.
model PaymentEvent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Пусто, если колбэк пришёл на неизвестный заказ — такие тоже сохраняем,
  /// иначе разбираться с провайдером будет нечем.
  donationId      String?        @map("donation_id") @db.Uuid
  provider        String         @db.VarChar(32)
  /// Идентификатор события у провайдера. Если провайдер своего не даёт
  /// (Robokassa присылает только номер счёта), подставляется детерминированный
  /// хеш тела — повторная доставка даёт тот же ключ.
  providerEventId String         @map("provider_event_id") @db.VarChar(128)
  status          DonationStatus
  amountKopecks   BigInt?        @map("amount_kopecks")
  payload         Json           @db.JsonB
  receivedAt      DateTime       @default(now()) @map("received_at") @db.Timestamptz(3)
  /// Заполняется, когда событие реально перевело донат в новый статус.
  /// Пусто — значит дубликат или колбэк без последствий.
  appliedAt       DateTime?      @map("applied_at") @db.Timestamptz(3)

  donation Donation? @relation(fields: [donationId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([donationId, receivedAt])
  @@map("payment_event")
}

/// Фотогалерея стройки (блок 6 ТЗ) — с самых первых этапов, хронологически.
/// width/height нужны фронтенду: без них Next.js не зарезервирует место
/// под картинку и первый экран будет прыгать.
model GalleryItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  imageUrl    String    @map("image_url") @db.VarChar(500)
  altText     String?   @map("alt_text") @db.VarChar(200)
  caption     String?   @db.VarChar(300)
  /// Дата съёмки — по ней галерея выстраивается в хронологию стройки.
  takenOn     DateTime? @map("taken_on") @db.Date
  width       Int?
  height      Int?
  sortOrder   Int       @default(100) @map("sort_order")
  isPublished Boolean   @default(true) @map("is_published")
  /// Фото из медиатеки. Пусто у строк, заведённых до админки (только image_url).
  /// Ссылка на сайт строится от файла медиатеки — смена бакета не ломает галерею.
  mediaAssetId String?  @map("media_asset_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([campaignId, isPublished, sortOrder, takenOn])
  @@index([mediaAssetId])
  @@map("gallery_item")
}

// ─── Админ-панель ───────────────────────────────────────────────────────────

/// Роли админки. SUPER_ADMIN — разработчик, EDITOR — заказчик (контент),
/// ACCOUNTANT — бухгалтер (платежи только на чтение плюс ручные поступления).
/// Права ролей — docs/admin/DECISIONS.md, D-06.
enum AdminRole {
  SUPER_ADMIN
  EDITOR
  ACCOUNTANT

  @@map("admin_role")
}

/// Пользователь админки. Публичной регистрации нет: первого суперадмина
/// создаёт сид из окружения, остальных — суперадмин.
model AdminUser {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Всегда в нижнем регистре — CHECK в миграции.
  email            String    @unique @db.VarChar(254)
  /// bcrypt-хеш. Сам пароль нигде не хранится и не логируется.
  passwordHash     String    @map("password_hash") @db.VarChar(100)
  role             AdminRole
  displayName      String?   @map("display_name") @db.VarChar(120)
  isActive         Boolean   @default(true) @map("is_active")
  /// Неудачные попытки входа подряд; при пороге выставляется locked_until.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Версия сессий. Входит в access-JWT и растёт при смене пароля, роли или
  /// деактивации: старые access-токены перестают приниматься сразу, а не через 15 минут.
  tokenVersion     Int       @default(0) @map("token_version")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens AdminRefreshToken[]

  @@map("admin_user")
}

/// Refresh-токены с ротацией. В базе только SHA-256 токена: утечка таблицы
/// не даёт войти. Все токены одной цепочки ротаций — одно семейство:
/// повторное предъявление уже использованного токена отзывает семейство целиком.
model AdminRefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Заполнен — токен использован (ротирован) или отозван.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(256)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("admin_refresh_token")
}

/// Журнал действий админки. Только дописывается: UPDATE и DELETE запрещены
/// триггером. Пишется в той же транзакции, что и само изменение, — правка
/// без записи в журнале не фиксируется. ПДн в before/after замаскированы.
model AuditLog {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// 'user' — пользователь админки; 'system' — вебхук, статический токен, сид.
  actorType  String     @map("actor_type") @db.VarChar(16)
  /// Без внешнего ключа намеренно: журнал переживает любые правки пользователей.
  actorId    String?    @map("actor_id") @db.Uuid
  actorRole  AdminRole? @map("actor_role")
  /// Снимок «кто»: e-mail на момент действия или имя системного источника.
  actorLabel String?    @map("actor_label") @db.VarChar(254)
  action     String     @db.VarChar(64)
  entityType String     @map("entity_type") @db.VarChar(64)
  entityId   String?    @map("entity_id") @db.VarChar(128)
  before     Json?      @db.JsonB
  after      Json?      @db.JsonB
  ip         String?    @db.Inet
  userAgent  String?    @map("user_agent") @db.VarChar(256)

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@map("audit_log")
}

// ─── Медиатека ──────────────────────────────────────────────────────────────

/// Загруженное изображение. Оригинал не хранится: сервер пережимает его в WebP
/// трёх размеров без EXIF (геометка с телефона — ПДн). Имя файла генерирует сервер.
model MediaAsset {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Общая часть ключей в хранилище: `2026/10/<uuid>`; файл варианта — `<key>-<size>.webp`.
  storageKey   String   @unique @map("storage_key") @db.VarChar(200)
  /// Размеры вариантов: [{ size, width, height, bytes }]. Ключ варианта выводится из storage_key.
  variants     Json     @db.JsonB
  /// Размер самого крупного варианта — им фронт резервирует место под картинку.
  width        Int
  height       Int
  bytes        Int
  /// Имя файла, как его загрузили, — только для поиска в медиатеке. В ключ не попадает.
  originalName String?  @map("original_name") @db.VarChar(200)
  altText      String?  @map("alt_text") @db.VarChar(300)
  /// Кто загрузил. Без внешнего ключа, как в журнале.
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  galleryItems GalleryItem[]
  videoPosters VideoLink[]
  stagePhotos  ConstructionStagePhoto[]
  newsCovers   NewsPost[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("media_asset")
}

/// Видео со стройки — только ссылки на VK Видео, Rutube, YouTube (D-13).
/// Видео не хостим: embed_url строится сервером из ссылки по allowlist доменов.
model VideoLink {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 'vk' | 'rutube' | 'youtube' — CHECK в миграции.
  provider      String   @db.VarChar(16)
  sourceUrl     String   @map("source_url") @db.VarChar(500)
  embedUrl      String   @map("embed_url") @db.VarChar(500)
  title         String?  @db.VarChar(200)
  posterMediaId String?  @map("poster_media_id") @db.Uuid
  sortOrder     Int      @default(100) @map("sort_order")
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  poster MediaAsset? @relation(fields: [posterMediaId], references: [id], onDelete: Restrict)

  @@index([isPublished, sortOrder])
  @@index([posterMediaId])
  @@map("video_link")
}

// ─── Контент сайта ──────────────────────────────────────────────────────────

/// Тексты главной, которые правит заказчик: hero, about, requisites, contacts, faq.
/// Структура каждого ключа — свой DTO (content/dto). Хадисы и юридические тексты
/// сюда не входят и через API не редактируются (D-10).
/// Картинки — id файлов медиатеки внутри JSON (поиск использования — по тексту JSON).
model ContentBlock {
  /// CHECK в миграции: только известные ключи.
  key         String   @id @db.VarChar(32)
  data        Json     @db.JsonB
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("content_block")
}

/// Статус этапа стройки на таймлайне главной.
enum ConstructionStageStatus {
  done
  current
  upcoming

  @@map("construction_stage_status")
}

/// Этап стройки (таймлайн макета v2): смета и освоено — в копейках, как все деньги.
model ConstructionStage {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String                  @db.VarChar(200)
  description   String?                 @db.Text
  status        ConstructionStageStatus @default(upcoming)
  /// Смета этапа. Пусто — сумма ещё не названа, сайт её не показывает.
  budgetKopecks BigInt?                 @map("budget_kopecks")
  /// Освоено по этапу. Не связано с суммой сбора — это отчёт о расходах.
  spentKopecks  BigInt?                 @map("spent_kopecks")
  sortOrder     Int                     @default(100) @map("sort_order")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  photos ConstructionStagePhoto[]

  @@index([sortOrder])
  @@map("construction_stage")
}

/// Фото этапа — из медиатеки, в заданном порядке.
model ConstructionStagePhoto {
  stageId      String @map("stage_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  stage      ConstructionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset        @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([stageId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("construction_stage_photo")
}

enum NewsStatus {
  draft
  published

  @@map("news_status")
}

/// Новость / отчёт (D-12). Текст — markdown без HTML: сервер отклоняет теги
/// и опасные ссылки, сайт рендерит без raw HTML.
model NewsPost {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String     @unique @db.VarChar(120)
  title        String     @db.VarChar(200)
  excerpt      String?    @db.VarChar(500)
  bodyMarkdown String     @map("body_markdown") @db.Text
  coverMediaId String?    @map("cover_media_id") @db.Uuid
  status       NewsStatus @default(draft)
  /// Заполнено ровно у опубликованных — CHECK в миграции.
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz(3)
  createdById  String?    @map("created_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cover MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([coverMediaId])
  @@map("news_post")
}
